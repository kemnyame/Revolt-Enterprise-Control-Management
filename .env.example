PORT=10000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revolt_controls
JWT_SECRET=replace-with-a-long-random-secret
INTEGRATION_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
ALLOWED_ORIGINS=http://localhost:10000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me-with-a-strong-password
ADMIN_NAME=Platform Administrator
# Production release checks must use an isolated database branch.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/revolt_controls_test
GMAIL_RELAY_ACTIVE=0
# Optional immediate SMTP delivery, leave blank for the connected Gmail relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
